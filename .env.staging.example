# =============================================================================
# Staging / homolog — Precisou, Tá Pronto (i18n)
# Copie para .env.staging em /opt/precisoutapronto-staging (NÃO commitar):
#   cp .env.staging.example .env.staging
# =============================================================================

APP_ENV=staging
DOMAIN=staging.precisoutapronto.com.br
NEXT_PUBLIC_APP_URL=https://staging.precisoutapronto.com.br

# --- PostgreSQL staging (volume separado do prod) ---
POSTGRES_USER=precisoutapronto
POSTGRES_PASSWORD=troque-esta-senha-staging
POSTGRES_DB=precisoutapronto_staging

# Evolution desligada no staging (compose.staging.yml)
EVOLUTION_API_KEY=staging-unused
EVOLUTION_DB_PASSWORD=staging-unused
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_ENABLED=false
WHATSAPP_INSTANCE=precisoutapronto-staging

# --- Stripe TEST (nunca live) ---
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PREMIUM_EN=
STRIPE_PRICE_PREMIUM_ES=
STRIPE_WEBHOOK_SECRET=
# Webhook staging: https://staging.precisoutapronto.com.br/api/webhooks/stripe

# Mercado Pago / Asaas / NuPay: deixe vazio ou sandbox se for testar BR
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
ASAAS_MODE=sandbox
ASAAS_API_KEY=
NUPAY_MODE=sandbox

# E-mail · mesma caixa Workspace; From com rótulo Staging
# Guia: docs/divulgacao/GOOGLE-WORKSPACE.md
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contato@precisoutapronto.com.br
SMTP_PASS=
SMTP_FROM=Precisou, Tá Pronto Staging <contato@precisoutapronto.com.br>
SMTP_SSL=false
SMTP_START_TLS=REQUIRED

# Auth
AUTH_SECRET=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SEO: staging é noindex (não precisa verification)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
