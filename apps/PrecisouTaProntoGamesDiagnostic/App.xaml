<Application x:Class="PrecisouTaProntoGamesDiagnostic.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#07111F" />
    <SolidColorBrush x:Key="PanelBrush" Color="#101D2E" />
    <SolidColorBrush x:Key="PanelSoftBrush" Color="#15263A" />
    <SolidColorBrush x:Key="TealBrush" Color="#18C5B5" />
    <SolidColorBrush x:Key="AmberBrush" Color="#FFC447" />
    <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9FB0C5" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI Semibold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#04131B" />
      <Setter Property="Background" Value="{StaticResource TealBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="20,12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="9" />
      <Setter Property="Foreground" Value="{StaticResource TealBrush}" />
      <Setter Property="Background" Value="#24364B" />
    </Style>
  </Application.Resources>
</Application>
