<Window x:Class="JatoGamesDiagnostic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jato Games Diagnostic" Width="1180" Height="780" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}">
  <Window.Resources>
    <Style x:Key="MetricCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelSoftBrush}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="74" />
      <RowDefinition Height="*" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0A1727" BorderBrush="#1F3349" BorderThickness="0,0,0,1">
      <Grid Margin="28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource TealBrush}" VerticalAlignment="Center">
          <TextBlock Text="JG" FontFamily="Segoe UI Black" FontSize="15" Foreground="#04131B" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="JATO GAMES DIAGNOSTIC" FontFamily="Segoe UI Black" FontSize="17" />
          <TextBlock Text="Inventário e benchmark local · seus dados permanecem neste PC" Foreground="{StaticResource MutedBrush}" FontSize="11" />
        </StackPanel>
        <Border Grid.Column="2" Padding="12,7" CornerRadius="16" Background="#153428" VerticalAlignment="Center">
          <TextBlock Text="●  MODO LOCAL SEGURO" Foreground="#65E6B4" FontFamily="Segoe UI Semibold" FontSize="11" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="28,24">
        <Grid x:Name="ConsentView">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width=".9*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,18,44,0">
            <TextBlock Text="DESCUBRA O LIMITE REAL DO SEU SETUP" Foreground="{StaticResource TealBrush}" FontFamily="Segoe UI Bold" FontSize="12" />
            <TextBlock Text="Seu PC roda&#x0a;o próximo jogo?" FontFamily="Segoe UI Black" FontSize="48" LineHeight="52" Margin="0,12,0,0" />
            <TextBlock Text="Medimos processamento, memória e armazenamento diretamente no Windows. Depois cruzamos os resultados com o perfil do jogo escolhido e entregamos um relatório visual de compatibilidade." Foreground="{StaticResource MutedBrush}" FontSize="16" TextWrapping="Wrap" LineHeight="25" Margin="0,18,0,0" />

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="18" Margin="0,28,0,0">
              <StackPanel>
                <TextBlock Text="O QUE SERÁ MEDIDO" FontFamily="Segoe UI Bold" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                <UniformGrid Columns="2" Margin="0,14,0,0">
                  <TextBlock Text="✓ CPU real e núcleos" Margin="0,7" />
                  <TextBlock Text="✓ GPU e driver" Margin="0,7" />
                  <TextBlock Text="✓ RAM instalada" Margin="0,7" />
                  <TextBlock Text="✓ Disco e espaço livre" Margin="0,7" />
                  <TextBlock Text="✓ Velocidade da memória" Margin="0,7" />
                  <TextBlock Text="✓ Leitura e escrita" Margin="0,7" />
                </UniformGrid>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="22" Padding="28">
            <StackPanel>
              <TextBlock Text="Preparar diagnóstico" FontFamily="Segoe UI Black" FontSize="26" />
              <TextBlock Text="Selecione o jogo que será usado como referência." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,7,0,0" />
              <ComboBox x:Name="GameSelector" Height="48" Margin="0,20,0,0" FontSize="14" Padding="10" Foreground="#0F172A" Background="#F8FAFC" />

              <Border Background="#0B1726" CornerRadius="14" Padding="18" Margin="0,20,0,0">
                <StackPanel>
                  <TextBlock Text="Privacidade por design" FontFamily="Segoe UI Bold" FontSize="14" />
                  <TextBlock Text="O programa acessará informações de hardware pelo Windows e criará um arquivo temporário de até 192 MB para medir o disco. O arquivo será apagado ao final. Nenhum resultado será transmitido automaticamente." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0" />
                </StackPanel>
              </Border>

              <CheckBox x:Name="ConsentCheck" Margin="0,22,0,0" Foreground="{StaticResource TextBrush}" FontSize="13">
                <TextBlock Text="Li e autorizo a coleta local e os benchmarks descritos acima." TextWrapping="Wrap" />
              </CheckBox>
              <Button x:Name="StartButton" Content="Iniciar diagnóstico completo  →" Margin="0,22,0,0" Click="StartButton_Click" />
              <TextBlock x:Name="ConsentWarning" Text="Marque o consentimento para iniciar." Foreground="#FF8E8E" Visibility="Collapsed" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid x:Name="BenchmarkView" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".72*" />
            <ColumnDefinition Width="1.28*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="20,0,50,0">
            <Border Width="160" Height="160" CornerRadius="80" Background="#11283A" BorderBrush="{StaticResource TealBrush}" BorderThickness="3" HorizontalAlignment="Left">
              <Grid>
                <TextBlock x:Name="ProgressNumber" Text="0%" FontFamily="Segoe UI Black" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <TextBlock Text="Benchmark em execução" FontFamily="Segoe UI Black" FontSize="30" Margin="0,28,0,0" />
            <TextBlock x:Name="StageText" Text="Preparando diagnóstico…" Foreground="{StaticResource TealBrush}" FontSize="15" Margin="0,10,0,0" />
            <ProgressBar x:Name="MainProgress" Minimum="0" Maximum="100" Margin="0,22,0,0" />
            <TextBlock Text="Não use aplicações pesadas durante o teste. A duração esperada é inferior a 15 segundos." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,15,0,0" />
          </StackPanel>

          <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="22" Padding="28">
            <StackPanel>
              <TextBlock Text="TELEMETRIA LOCAL DO TESTE" Foreground="{StaticResource AmberBrush}" FontFamily="Segoe UI Bold" FontSize="11" />
              <TextBlock x:Name="LiveHardware" Text="Coletando inventário do Windows…" FontFamily="Consolas" Foreground="#B9C8D9" TextWrapping="Wrap" LineHeight="25" Margin="0,18,0,0" />
              <Border Background="#07111F" CornerRadius="14" Padding="18" Margin="0,24,0,0">
                <StackPanel>
                  <TextBlock Text="Sequência controlada" FontFamily="Segoe UI Bold" />
                  <TextBlock Text="01  Inventário WMI&#x0a;02  CPU single thread&#x0a;03  CPU multi thread&#x0a;04  Throughput de memória&#x0a;05  Disco temporário&#x0a;06  Análise contra o jogo" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" LineHeight="26" Margin="0,12,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Grid x:Name="ReportView" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="138" Height="138" CornerRadius="69" Background="#102B32" BorderBrush="{StaticResource TealBrush}" BorderThickness="8">
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="OverallScore" Text="--" FontFamily="Segoe UI Black" FontSize="40" HorizontalAlignment="Center" />
                <TextBlock Text="/ 100" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Margin="24,10,0,0">
              <TextBlock Text="RELATÓRIO CONCLUÍDO" Foreground="{StaticResource TealBrush}" FontFamily="Segoe UI Bold" FontSize="11" />
              <TextBlock x:Name="VerdictText" Text="Perfil compatível" FontFamily="Segoe UI Black" FontSize="32" Margin="0,8,0,0" />
              <TextBlock x:Name="ReportSubtitle" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,0" />
              <TextBlock Text="Fidelidade do diagnóstico: 91%" Foreground="#65E6B4" FontFamily="Segoe UI Semibold" Margin="0,9,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Exportar JSON" Background="{StaticResource AmberBrush}" Margin="0,0,10,0" Click="ExportButton_Click" />
              <Button Content="Novo teste" Background="#294056" Foreground="White" Click="RestartButton_Click" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
              <StackPanel><TextBlock Text="CPU" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="CpuScoreText" FontFamily="Segoe UI Black" FontSize="28" Margin="0,8,0,0" /><ProgressBar x:Name="CpuBar" Margin="0,12,0,0" /><TextBlock x:Name="CpuDetail" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCard}">
              <StackPanel><TextBlock Text="GRÁFICOS" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="GpuScoreText" FontFamily="Segoe UI Black" FontSize="28" Margin="0,8,0,0" /><ProgressBar x:Name="GpuBar" Margin="0,12,0,0" /><TextBlock x:Name="GpuDetail" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" /></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
              <StackPanel><TextBlock Text="MEMÓRIA" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="MemoryScoreText" FontFamily="Segoe UI Black" FontSize="28" Margin="0,8,0,0" /><ProgressBar x:Name="MemoryBar" Margin="0,12,0,0" /><TextBlock x:Name="MemoryDetail" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" /></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCard}" Margin="0">
              <StackPanel><TextBlock Text="ARMAZENAMENTO" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="StorageScoreText" FontFamily="Segoe UI Black" FontSize="28" Margin="0,8,0,0" /><ProgressBar x:Name="StorageBar" Margin="0,12,0,0" /><TextBlock x:Name="StorageDetail" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" /></StackPanel>
            </Border>
          </Grid>

          <Grid Grid.Row="2" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.25*" />
              <ColumnDefinition Width=".75*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="22" Margin="0,0,16,0">
              <StackPanel>
                <TextBlock Text="Análise e recomendações" FontFamily="Segoe UI Black" FontSize="20" />
                <ItemsControl x:Name="FindingsList" Margin="0,12,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding StringFormat=•  {0}}" Foreground="#C4D0DE" TextWrapping="Wrap" Margin="0,5" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="22">
              <StackPanel>
                <TextBlock Text="Hardware detectado" FontFamily="Segoe UI Black" FontSize="20" />
                <TextBlock x:Name="HardwareSummary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,13,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="28,0">
      <TextBlock Text="Jato Games Diagnostic 0.1.0 · benchmark local educativo · nenhum dado é enviado automaticamente" Foreground="#62758C" FontSize="10" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
