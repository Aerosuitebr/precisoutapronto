# =============================================================================
# Desenvolvimento local
# =============================================================================
# Opção A — Supabase (PostgreSQL gerenciado):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Opção B — Docker de produção/local (stack completa): veja .env.production.example e DOCKER.md
# DATABASE_URL="postgresql://resolvajato:SENHA@localhost:5432/resolvajato?schema=public"

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL pública do app (links de orçamento / retorno Mercado Pago)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- WhatsApp (Evolution) — dev: npm run whatsapp:up ---
# 1) npm run whatsapp:up
# 2) npm run whatsapp:setup
# 3) Escaneie o QR em Minha conta (ou GET /api/whatsapp/status)
WHATSAPP_PROVIDER="evolution"
WHATSAPP_API_ENABLED="true"
EVOLUTION_API_URL="http://localhost:18083"
WHATSAPP_API_URL="http://localhost:18083"
EVOLUTION_API_KEY="resolva-jato-evolution-api-key-2026"
WHATSAPP_API_TOKEN="resolva-jato-evolution-api-key-2026"
WHATSAPP_INSTANCE="resolva-jato"

# E-mail de alerta / verificação de conta
RESEND_API_KEY=""
RESEND_FROM=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Resolva Jato <contato@aerosuite.com.br>"
SMTP_SSL="false"
SMTP_START_TLS="REQUIRED"

# Auth (cookie de sessão) — gere com: openssl rand -hex 32
AUTH_SECRET="troque-por-um-segredo-longo-em-producao"

# Cloudflare Turnstile (cadastro) — https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Em desenvolvimento, sem as chaves o captcha é ignorado.

# SMS (Twilio) — opcional
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Mercado Pago Checkout Pro
# Credenciais em: Suas integrações > Resolva Jato > Credenciais de teste / produção
# production = dinheiro real (init_point) | sandbox = credenciais de teste
MERCADOPAGO_MODE="production"
NEXT_PUBLIC_MERCADOPAGO_MODE="production"
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
# Opcionais (OAuth / algumas integrações)
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
# Secret do webhook (Suas integrações → Webhooks). Com valor, valida x-signature (HMAC).
MERCADOPAGO_WEBHOOK_SECRET=""

# Stripe (Payments / Invoicing / Tax)
# Chaves em: https://dashboard.stripe.com/apikeys (use as de teste em dev)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Price do produto "Resolva Jato Premium" (Dashboard → Product catalog)
STRIPE_PRICE_PREMIUM=""
# Webhook: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# NuPay for Business (Nubank) — opção extra de pagamento Premium
# Painel: https://sandbox-painel.spinpay.com.br / https://painel.spinpay.com.br
# Credenciais: aba Credentials → APP KEY + APP TOKEN
NUPAY_MODE="sandbox"
NUPAY_APP_KEY=""
NUPAY_APP_TOKEN=""
# Webhook: https://seu-dominio/api/webhooks/nupay

# Zoop (legado / inativo se a conta não foi aprovada)
ZOOP_MODE="sandbox"
ZOOP_MARKETPLACE_ID=""
# Chave secreta zpk (servidor). Basic Auth: zpk como usuário, senha vazia.
ZOOP_API_KEY=""
# Vendedor que recebe (on_behalf_of). Em conta única, o seller do próprio marketplace.
ZOOP_SELLER_ID=""
# Token opcional validado no header Authorization do webhook (defina o mesmo no painel).
ZOOP_WEBHOOK_TOKEN=""
# Webhook: https://seu-dominio/api/webhooks/zoop
# Públicas (tokenização do cartão no navegador, mantém o PCI fora do backend):
NEXT_PUBLIC_ZOOP_MARKETPLACE_ID=""
NEXT_PUBLIC_ZOOP_PUBLISHABLE_KEY=""

# Asaas (Pix e cartão) — https://docs.asaas.com
# Sandbox: https://sandbox.asaas.com → Integrações → Chave de API
# Produção: https://www.asaas.com → Integrações → Chave de API
ASAAS_MODE="sandbox"
# Chave completa, incluindo o prefixo $aact_hmlg_ (sandbox) ou $aact_prod_ (produção)
ASAAS_API_KEY=""
# Token do webhook (header asaas-access-token). Defina o mesmo valor no painel Asaas.
ASAAS_WEBHOOK_TOKEN=""
# Webhook: https://seu-dominio/api/webhooks/asaas
# Eventos: PAYMENT_RECEIVED, PAYMENT_CONFIRMED

# Web Push (opcional) — npm run push:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@resolvajato.com.br"

# =============================================================================
# Produção Docker (resumo)
# =============================================================================
# cp .env.production.example .env
# Preencha POSTGRES_PASSWORD, EVOLUTION_API_KEY, MERCADOPAGO_* (produção)
# DOMAIN=resolvajato.com.br
# NEXT_PUBLIC_APP_URL=https://resolvajato.com.br
# npm run docker:up
# Detalhes: DOCKER.md
