generator client {
  provider = "prisma-client-js"
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  segment     String
  occupation  String?
  companyName String?
  logoDataUrl String?
  preferences Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([segment])
  @@map("user_profiles")
}

model SharedDocument {
  id             String    @id @default(cuid())
  token          String    @unique
  ownerId        String
  toolDocumentId String
  title          String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  viewCount      Int       @default(0)
  lastViewedAt   DateTime?

  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  toolDocument ToolDocument @relation(fields: [toolDocumentId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([toolDocumentId])
  @@map("shared_documents")
}

/// Resultado curto, anonimizado e criado somente após ação explícita de compartilhamento.
model SharedResult {
  id           String    @id @default(cuid())
  token        String    @unique
  tool         String
  title        String
  subtitle     String?
  data         Json
  ctaLabel     String
  ctaPath      String
  source       String    @default("result")
  referrer     String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  @@index([tool, createdAt])
  @@index([expiresAt])
  @@map("shared_results")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrcamentoStatus {
  pending
  approved
  declined
}

enum BlacklistType {
  ip
  email
  domain
  device
}

model Orcamento {
  id                      String          @id @default(uuid()) @db.Uuid
  profissionalNome        String
  profissionalWhatsapp    String
  clienteNome             String
  clienteContato          String          @default("")
  clienteEmail            String          @default("")
  itens                   Json
  total                   Float
  validade                String          @default("")
  observacoes             String          @default("")
  pixKey                  String          @default("")
  pixKeyType              String          @default("")
  pixMerchantName         String          @default("")
  pixMerchantCity         String          @default("")
  status                  OrcamentoStatus @default(pending)
  feedbackCliente         String?
  ownerEmail              String?
  profissionalLogoDataUrl String?
  sourceOccupation        String?
  recruitedFromDocument   String?
  firstViewedAt           DateTime?
  firstRecruitClickedAt   DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([ownerEmail])
  @@index([status])
  @@index([sourceOccupation, createdAt])
  @@index([recruitedFromDocument, createdAt])
  @@index([firstViewedAt])
  @@index([firstRecruitClickedAt])
  @@map("orcamentos")
}

model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  ownerEmail String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerEmail])
  @@map("push_subscriptions")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  passwordHash     String
  emailVerifiedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?
  lastLoginIp      String?
  riskFlags        String?
  referralCode     String?   @unique
  referredByUserId String?

  referredBy                 User?                @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals                  User[]               @relation("UserReferrals")
  referralActivationsGiven   ReferralActivation[] @relation("ReferrerActivations")
  referralActivationReceived ReferralActivation?  @relation("ReferredActivation")
  referralRewards            ReferralReward[]

  verificationTokens EmailVerificationToken[]
  toolUsage          ToolUsage?
  subscription       Subscription?
  deviceLinks        DeviceCookieLink[]
  auditLogs          AuditLog[]
  toolsPreference    ToolsPreference?
  activeSession      UserSession?
  agendaEvents       AgendaEvent[]
  toolDocuments      ToolDocument[]
  profile            UserProfile?
  sharedDocuments    SharedDocument[]

  @@index([createdAt])
  @@index([referredByUserId])
  @@map("users")
}

model AgendaEvent {
  id           String   @id
  userId       String
  title        String
  client       String   @default("")
  date         String
  startTime    String
  endTime      String
  location     String   @default("")
  notes        String   @default("")
  alertMinutes Int      @default(30)
  priority     String   @default("normal")
  status       String   @default("confirmed")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("agenda_events")
}

model ToolDocument {
  id         String   @id @default(cuid())
  userId     String
  toolId     String
  artifactId String
  data       Json
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares SharedDocument[]

  @@unique([userId, toolId, artifactId])
  @@index([userId, toolId, updatedAt])
  @@index([userId, isFavorite, updatedAt])
  @@map("tool_documents")
}

/// Uma sessão ativa por usuário: login novo substitui e invalida as anteriores.
model UserSession {
  id             String   @id @default(cuid())
  userId         String   @unique
  tokenHash      String   @unique
  deviceCookieId String?
  userAgent      String?
  ip             String?
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  expiresAt      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("user_sessions")
}

model ToolsPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  favoriteToolIds     Json     @default("[]")
  recentToolIds       Json     @default("[]")
  openCounts          Json     @default("{}")
  pinnedCategoryId    String?
  collapsedCategories Json     @default("[]")
  sectionsCustomized  Boolean  @default(false)
  wizardDismissed     Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tools_preferences")
}

model ReferralActivation {
  id          String   @id @default(cuid())
  referrerId  String
  referredId  String   @unique
  activatedAt DateTime @default(now())

  referrer User @relation("ReferrerActivations", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferredActivation", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referral_activations")
}

model ReferralReward {
  id          String   @id @default(cuid())
  referrerId  String
  grantedAt   DateTime @default(now())
  expiresAt   DateTime
  batchSize   Int      @default(3)
  providerRef String   @unique

  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referral_rewards")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model ToolUsage {
  id            String    @id @default(cuid())
  userId        String    @unique
  availableUses Int       @default(5)
  totalConsumed Int       @default(0)
  exhaustedAt   DateTime?
  nextReleaseAt DateTime?
  periodDays    Int       @default(30)
  recentActions Json      @default("[]")
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tool_usages")
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String   @unique
  planId      String   @default("premium")
  startedAt   DateTime @default(now())
  expiresAt   DateTime
  providerRef String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("subscriptions")
}

model DeviceCookie {
  id          String   @id @default(cuid())
  uuid        String   @unique
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  userAgent   String?
  language    String?
  timezone    String?

  links DeviceCookieLink[]

  @@map("device_cookies")
}

model DeviceCookieLink {
  id             String   @id @default(cuid())
  deviceCookieId String
  userId         String
  createdAt      DateTime @default(now())

  deviceCookie DeviceCookie @relation(fields: [deviceCookieId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deviceCookieId, userId])
  @@index([userId])
  @@map("device_cookie_links")
}

model AuditLog {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  email     String?
  ip        String?
  userAgent String?
  deviceId  String?
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
  @@index([ip, createdAt])
  @@index([deviceId, createdAt])
  @@index([email, createdAt])
  @@map("audit_logs")
}

model BlacklistEntry {
  id        String        @id @default(cuid())
  type      BlacklistType
  value     String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime      @default(now())

  @@unique([type, value])
  @@index([expiresAt])
  @@map("blacklist_entries")
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime

  @@index([windowStart])
  @@map("rate_limit_buckets")
}

model ProductEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventName     String
  occurredAt    DateTime
  userId        String?
  anonymousId   String
  sessionId     String
  toolKey       String?
  taskId        String?  @db.Uuid
  artifactId    String?  @db.Uuid
  properties    Json     @default("{}")
  schemaVersion Int      @default(1)
  receivedAt    DateTime @default(now())

  @@index([occurredAt])
  @@index([eventName, occurredAt])
  @@index([userId, occurredAt])
  @@index([anonymousId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([toolKey, occurredAt])
  @@map("product_events")
}

model FeatureFlag {
  key            String   @id
  description    String
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(0)
  rules          Json     @default("{}")
  updatedAt      DateTime @updatedAt

  @@map("feature_flags")
}

model ExperimentAssignment {
  id            String   @id @default(uuid()) @db.Uuid
  experimentKey String
  subjectKey    String
  variant       String
  assignedAt    DateTime @default(now())

  @@unique([experimentKey, subjectKey])
  @@index([experimentKey, assignedAt])
  @@map("experiment_assignments")
}

model IntentNode {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique @db.VarChar(80)
  type           String   @db.VarChar(32)
  label          String   @db.VarChar(120)
  description    String
  frequencyClass String   @db.VarChar(24)
  riskLevel      String   @db.VarChar(24)
  active         Boolean  @default(true)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  outgoingEdges IntentEdge[] @relation("IntentEdgeFrom")
  incomingEdges IntentEdge[] @relation("IntentEdgeTo")

  @@index([type, active])
  @@map("intent_nodes")
}

model IntentEdge {
  id             String   @id @default(uuid()) @db.Uuid
  fromNodeId     String   @db.Uuid
  toNodeId       String   @db.Uuid
  relationType   String   @db.VarChar(32)
  weight         Decimal  @db.Decimal(6, 3)
  transferSchema Json     @default("{}")
  ruleJson       Json     @default("{}")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fromNode IntentNode @relation("IntentEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Restrict)
  toNode   IntentNode @relation("IntentEdgeTo", fields: [toNodeId], references: [id], onDelete: Restrict)

  @@unique([fromNodeId, toNodeId, relationType])
  @@index([fromNodeId, active])
  @@index([toNodeId, active])
  @@map("intent_edges")
}

model Task {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String?
  anonymousSessionId String?
  toolKey            String    @db.VarChar(80)
  intentKey          String?   @db.VarChar(80)
  status             String    @default("started") @db.VarChar(32)
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  sourceChannel      String?   @db.VarChar(48)
  sourceUrl          String?
  parentTaskId       String?   @db.Uuid
  contextSnapshot    Json      @default("{}")
  experimentSnapshot Json      @default("{}")

  parentTask Task?      @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks Task[]     @relation("TaskHierarchy")
  artifacts  Artifact[]
  recommendationSources RecommendationExposure[] @relation("RecommendationSourceTask")
  recommendationCompletions RecommendationExposure[] @relation("RecommendationCompletedTask")

  @@index([userId, startedAt])
  @@index([anonymousSessionId, startedAt])
  @@index([toolKey, startedAt])
  @@index([status, startedAt])
  @@index([parentTaskId])
  @@map("tasks")
}

model Artifact {
  id               String    @id @default(uuid()) @db.Uuid
  taskId           String    @db.Uuid
  userId           String?
  artifactType     String    @db.VarChar(48)
  toolKey          String    @db.VarChar(80)
  publicId         String?   @unique @db.VarChar(120)
  visibility       String    @default("private") @db.VarChar(16)
  title            String?
  payloadJson      Json      @default("{}")
  summaryJson      Json      @default("{}")
  status           String    @default("draft") @db.VarChar(32)
  version          Int       @default(1)
  duplicatedFromId String?   @db.Uuid
  templateId       String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  expiresAt        DateTime?

  task              Task               @relation(fields: [taskId], references: [id], onDelete: Restrict)
  duplicatedFrom    Artifact?          @relation("ArtifactDuplication", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates        Artifact[]         @relation("ArtifactDuplication")
  outgoingRelations ArtifactRelation[] @relation("ArtifactRelationSource")
  incomingRelations ArtifactRelation[] @relation("ArtifactRelationTarget")
  sourceTemplates    PersonalTemplate[] @relation("PersonalTemplateSource")
  instantiatedFrom  PersonalTemplate?  @relation("ArtifactTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  shareLinks         ShareLink[]
  recommendationExposures RecommendationExposure[]

  @@index([taskId, updatedAt])
  @@index([userId, updatedAt])
  @@index([toolKey, updatedAt])
  @@index([visibility, updatedAt])
  @@index([duplicatedFromId])
  @@index([templateId])
  @@map("artifacts")
}

model PersonalTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  ownerUserId      String
  sourceArtifactId String   @db.Uuid
  toolKey          String   @db.VarChar(80)
  name             String   @db.VarChar(120)
  templatePayload  Json     @default("{}")
  visibility       String   @default("private") @db.VarChar(16)
  status           String   @default("active") @db.VarChar(24)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sourceArtifact Artifact   @relation("PersonalTemplateSource", fields: [sourceArtifactId], references: [id], onDelete: Restrict)
  instances      Artifact[] @relation("ArtifactTemplate")

  @@index([ownerUserId, updatedAt])
  @@index([toolKey, visibility, status])
  @@index([sourceArtifactId])
  @@map("personal_templates")
}

model ShareLink {
  id              String    @id @default(uuid()) @db.Uuid
  artifactId      String    @db.Uuid
  tokenHash       String    @unique @db.Char(64)
  channel         String    @db.VarChar(32)
  createdByUserId String?
  campaign        String?   @db.VarChar(80)
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  artifact Artifact     @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  events   ShareEvent[]

  @@index([artifactId, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([expiresAt])
  @@map("share_links")
}

model ShareEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  shareLinkId          String   @db.Uuid
  eventType            String   @db.VarChar(40)
  anonymousRecipientId String   @db.VarChar(80)
  userId               String?
  occurredAt           DateTime @default(now())
  metadata             Json     @default("{}")

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Restrict)

  @@index([shareLinkId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("share_events")
}

model RecommendationExposure {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String?
  sessionId           String?
  sourceTaskId        String?   @db.Uuid
  sourceArtifactId    String?   @db.Uuid
  recommendationKey   String    @db.VarChar(80)
  targetToolKey       String    @db.VarChar(80)
  variant             String    @default("default") @db.VarChar(48)
  rank                Int
  shownAt             DateTime  @default(now())
  clickedAt           DateTime?
  completedTaskId     String?   @db.Uuid

  sourceTask    Task?     @relation("RecommendationSourceTask", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  sourceArtifact Artifact? @relation(fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  completedTask Task?     @relation("RecommendationCompletedTask", fields: [completedTaskId], references: [id], onDelete: SetNull)

  @@index([userId, shownAt])
  @@index([sessionId, shownAt])
  @@index([sourceTaskId, shownAt])
  @@index([sourceArtifactId, shownAt])
  @@index([recommendationKey, shownAt])
  @@index([targetToolKey, shownAt])
  @@map("recommendation_exposures")
}

model HelpfulnessFeedback {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?
  anonymousId String   @db.VarChar(80)
  targetType  String   @db.VarChar(40)
  targetId    String   @db.VarChar(128)
  rating      String   @db.VarChar(24)
  detail      String?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([userId, createdAt])
  @@index([anonymousId, createdAt])
  @@map("helpfulness_feedback")
}

model ResolutionRequest {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?
  anonymousId      String   @db.VarChar(80)
  rawText          String
  normalizedIntent String?  @db.VarChar(120)
  source           String   @db.VarChar(48)
  status           String   @default("received") @db.VarChar(24)
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
  @@index([normalizedIntent, createdAt])
  @@index([userId, createdAt])
  @@index([anonymousId, createdAt])
  @@map("resolution_requests")
}

model AiInteraction {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?
  sessionId     String?
  capability    String    @db.VarChar(80)
  modelKey      String    @db.VarChar(80)
  promptVersion String    @db.VarChar(48)
  inputHash     String    @db.Char(64)
  outputJson    Json      @default("{}")
  safetyResult  Json      @default("{}")
  latencyMs     Int
  estimatedCost Decimal   @default(0) @db.Decimal(12, 6)
  accepted      Boolean?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([capability, createdAt])
  @@index([modelKey, createdAt])
  @@index([inputHash, createdAt])
  @@map("ai_interactions")
}

model ArtifactRelation {
  id                String   @id @default(uuid()) @db.Uuid
  sourceArtifactId  String   @db.Uuid
  targetArtifactId  String   @db.Uuid
  relationType      String   @db.VarChar(48)
  transferredFields Json     @default("{}")
  createdAt         DateTime @default(now())

  sourceArtifact Artifact @relation("ArtifactRelationSource", fields: [sourceArtifactId], references: [id], onDelete: Restrict)
  targetArtifact Artifact @relation("ArtifactRelationTarget", fields: [targetArtifactId], references: [id], onDelete: Restrict)

  @@unique([sourceArtifactId, targetArtifactId, relationType])
  @@index([targetArtifactId, createdAt])
  @@map("artifact_relations")
}

model UserBusinessProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique
  displayName          String?
  legalName            Bytes?
  taxIdEncrypted       Bytes?
  email                Bytes?
  phone                Bytes?
  addressJson          Bytes?
  logoAssetId          String?  @db.Uuid
  pixJson              Bytes?
  signatureAssetId     String?  @db.Uuid
  preferencesJson      Json     @default("{}")
  encryptionKeyVersion String?  @db.VarChar(32)
  consentVersion       String   @db.VarChar(32)
  consentedAt          DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_business_profiles")
}

model Customer {
  id                   String    @id @default(uuid()) @db.Uuid
  ownerUserId          String
  type                 String    @db.VarChar(24)
  displayName          String
  legalName            Bytes?
  taxIdEncrypted       Bytes?
  email                Bytes?
  phone                Bytes?
  addressJson          Bytes?
  metadata             Json      @default("{}")
  encryptionKeyVersion String?   @db.VarChar(32)
  consentVersion       String    @db.VarChar(32)
  consentedAt          DateTime
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([ownerUserId, archivedAt])
  @@index([ownerUserId, displayName])
  @@map("customers")
}

model ContextAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String
  entityType     String   @db.VarChar(32)
  entityId       String   @db.Uuid
  action         String   @db.VarChar(32)
  changedFields  Json     @default("[]")
  consentVersion String?  @db.VarChar(32)
  occurredAt     DateTime @default(now())

  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("context_audit_events")
}
